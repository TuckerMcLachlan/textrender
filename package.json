{
  "name": "textrender",
  "private": true,
  "version": "0.1.0",
  "description": "Procedural shader materials for React typography",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build:site": "tsc --noEmit && vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "build": "npm run build:lib",
    "prepack": "npm run build:lib",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "preview": "vite preview --host 0.0.0.0"
  },
  "keywords": [
    "react",
    "shader",
    "typography",
    "webgl"
  ],
  "license": "ISC",
  "packageManager": "pnpm@10.11.0",
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@fontsource/bodoni-moda": "^5.2.0",
    "@fontsource/dm-sans": "^5.2.0",
    "@fontsource/space-grotesk": "^5.2.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "dialkit": "^2.0.2"
  }
}
